# =============================================================================
# WCO Platform — environment example (public / local only)
# Copy to .env.local for local overrides. NEVER commit real secrets.
# =============================================================================

# Vite public vars — safe to expose to the browser (no private keys)

# API base override (optional)
# VITE_API_BASE_URL=

# Hedera network for WalletConnect + Mirror (default: mainnet)
# Team test on WCO-Resolver: set testnet. Production www.wcorg.io: leave mainnet / unset.
# VITE_HEDERA_NETWORK=mainnet
# VITE_HEDERA_NETWORK=testnet

# Optional separate WalletConnect / Reown project for test origins only
# VITE_WC_PROJECT_ID=

# Hybrid governance (client flags — server still authoritative)
# Leave disabled on production until cutover checklist passes.
# VITE_GOV_HCS_ENABLED=false
# VITE_GOV_READ_MODE=kv
# VITE_HCS_SUBMIT_MODE=wallet

# Public token / topic IDs only (0.0.x) — never private keys
# VITE_GOVERNOR_NFT_TOKEN_ID=0.0.9338241
# VITE_ADMIN_NFT_TOKEN_ID=
# VITE_TREASURY_ACCOUNT_ID=
# VITE_HCS_GOV_TOPIC_ID=
# VITE_HCS_AUDIT_TOPIC_ID=
# VITE_HCS_VOTES_TOPIC_ID=
# VITE_BOTB_TOKEN_ID=
# Hedera-native USDC (mainnet default 0.0.456858). Override for testnet if needed.
# VITE_USDC_TOKEN_ID=0.0.456858
# VITE_SIGMA_NFT_TOKEN_ID=
# VITE_META_NFT_TOKEN_ID=

# -----------------------------------------------------------------------------
# Early Supporter free NFT claim (Phase 1 — local mock; production OFF)
# -----------------------------------------------------------------------------
# Keep both false on www.wcorg.io until deliberate rollout.
# Local testing: set both true in .env.local (mock uses localStorage, no Edge writes).
# VITE_EARLY_SUPPORTER_ENABLED=false
# VITE_EARLY_SUPPORTER_LOCAL_MOCK=false
# VITE_EARLY_SUPPORTER_NFT_TOKEN_ID=
# VITE_EARLY_SUPPORTER_TREASURY_ACCOUNT_ID=0.0.10821146
#
# Edge secrets (Supabase dashboard — NEVER VITE_ / never commit):
#   EARLY_SUPPORTER_ENABLED=false
#   EARLY_SUPPORTER_MINT_ENABLED=false
#   EARLY_SUPPORTER_REQUIRE_ACTIVITY=false
#   EARLY_SUPPORTER_DEBUG=false
#   EARLY_SUPPORTER_NFT_TOKEN_ID=
#   EARLY_SUPPORTER_TREASURY_ACCOUNT_ID=0.0.10821146

# Supabase project ref is also baked into utils/supabase/info.tsx for the SPA.
# Edge functions use Supabase secrets set in the Supabase dashboard / CLI — not this file.
# See docs/governance/TESTNET_RUNBOOK.md for Edge secret names (no values here).

# -----------------------------------------------------------------------------
# Magic “Create Account” (email / Google / Apple) — additive to HashPack connect
# -----------------------------------------------------------------------------
# Leave VITE_MAGIC_ENABLED=false until Magic dashboard + Edge secrets are ready.
# When false, Connect Wallet behaves exactly as today (HashPack / WalletConnect only).
# VITE_MAGIC_ENABLED=false
# VITE_MAGIC_PUBLISHABLE_KEY=pk_live_...

# Do not put private keys, treasury seed phrases, or service-role keys here.
# Local Hedera scripts use scripts/hedera/.env.hedera (gitignored) — see .env.hedera.example.
#
# Edge secrets for Magic account sponsorship (Supabase dashboard / CLI — NEVER Vite):
#   MAGIC_SECRET_KEY=
#   MAGIC_ACCOUNT_CREATE_ENABLED=true
#   HEDERA_OPERATOR_ID=0.0.x
#   HEDERA_OPERATOR_KEY=...   # NEVER use VITE_ prefix — that exposes the private key in the browser bundle
#   HEDERA_NETWORK=mainnet
# See docs/magic-onboarding.md
