# =============================================================================
# WCO Bot BV2 Environment Variables
# Copy this file to .env and fill in your real values
# =============================================================================

# WalletConnect (required for Hedera wallet login)
# Get your Project ID at: https://cloud.reown.com (formerly WalletConnect Cloud)
VITE_WC_PROJECT_ID=your_walletconnect_project_id_here

# Optional: Supabase (if you add more backend features later)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Hedera Mirror Node (for advanced features)
# VITE_HEDERA_MIRROR_NODE_URL=https://mainnet-public.mirror.nodes.hedera.com