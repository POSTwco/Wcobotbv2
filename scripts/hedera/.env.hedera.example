# =============================================================================
# LOCAL ONLY — copy to .env.hedera (gitignored via .env.*)
# NEVER commit real keys. NEVER paste keys into chat or GitHub.
# =============================================================================

HEDERA_NETWORK=testnet

# Public account IDs
TREASURY_ACCOUNT_ID=0.0.REPLACE
# Optional operator for topic create / operator-mode submit
OPERATOR_ACCOUNT_ID=0.0.REPLACE

# Private keys — ED25519 DER or hex as accepted by @hashgraph/sdk PrivateKey.fromString
# Leave blank and use stdin if your process forbids env files on disk.
TREASURY_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=

# Optional: pre-generated submit keypair for private topics
# If empty, scripts generate one and print PUBLIC key only + path hint for secret store
HCS_SUBMIT_PRIVATE_KEY=
HCS_ADMIN_PRIVATE_KEY=

# After create scripts succeed, paste public results here for 04-verify-mirror
ADMIN_NFT_TOKEN_ID=
HCS_GOV_TOPIC_ID=
HCS_AUDIT_TOPIC_ID=

# Early Supporter NFT (06-create / 07-mint) — PUBLIC ids + metadata URI only below
# Resolver / treasury wallet (mainnet): 0.0.10821146
EARLY_SUPPORTER_NFT_TOKEN_ID=
# Public HTTPS (or ipfs://) metadata JSON — not signed Storage URLs
EARLY_SUPPORTER_METADATA_URI=
# Optional mint controls for 07-mint-early-supporter-batch.mjs
# EARLY_SUPPORTER_MINT_TOTAL=5000
# EARLY_SUPPORTER_MINT_CHUNK=10
# EARLY_SUPPORTER_MINT_START=1
